# Performance OS — mobile app (Vite) environment example.
#
# Copy this file to .env.local (same folder) and fill in real values.
# .env.local is gitignored — NEVER commit it. Vite exposes every var
# prefixed with VITE_ to the browser, so ONLY browser-safe values belong
# here. The Supabase service_role key must NEVER appear in this file.
#
# The deployed build gets these same names from GitHub Actions secrets
# (.github/workflows/deploy.yml). Server-side secrets (FITBIT_CLIENT_SECRET,
# STRAVA_CLIENT_SECRET, SUPABASE_SERVICE_ROLE_KEY, ...) live ONLY in
# Supabase Edge Function secrets (`supabase secrets set`), never here.

# ── Supabase (required — without these the app runs local-only) ─────────────
# Project Settings → API in the Supabase dashboard.
# The anon key is safe in the browser; Row Level Security protects the data.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# ── Wearables (optional — only needed to test device connect flows) ─────────
# Fitbit data comes via the Google OAuth client (Google Health API).
VITE_FITBIT_CLIENT_ID="YOUR-GOOGLE-OAUTH-CLIENT-ID"
# Optional override of the OAuth authorize URL; leave unset for the default
# (https://accounts.google.com/o/oauth2/v2/auth).
# VITE_FITBIT_OAUTH_URL=""

# Strava API application client ID (https://www.strava.com/settings/api).
VITE_STRAVA_CLIENT_ID="YOUR-STRAVA-CLIENT-ID"
