# Performance OS — web app environment example.
# Copy to .env.local and fill in to activate integrations. .env.local is gitignored.
# Everything here is OPTIONAL — with none set, the site works (forms email you via
# mailto, analytics stays off). NEXT_PUBLIC_ vars are exposed to the browser.

# ── Lead capture ────────────────────────────────────────────────────────────
# Where the contact / footer / lead-magnet forms POST. Pick ONE:
#   Formspree (easiest, no server, free tier): create a form, paste its URL.
#   This app's own route:                       use "/api/leads".
# Leave blank to fall back to a pre-filled email (mailto).
# NEXT_PUBLIC_LEADS_ENDPOINT="https://formspree.io/f/xxxxxxxx"
# NEXT_PUBLIC_LEADS_ENDPOINT="/api/leads"

# ── Analytics ───────────────────────────────────────────────────────────────
# Plausible — privacy-first, no cookie banner needed. Set your site domain.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN="performanceos.app"

# Google Analytics 4 — needs a cookie/consent banner under UK/EU law.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ── Server-only secrets (used by app/api/leads if you wire delivery) ─────────
# Never prefix these with NEXT_PUBLIC (they must stay on the server).
# RESEND_API_KEY="re_xxx"
