{
  "name": "performance-os",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w hybrid-react",
    "build": "npm run build -w hybrid-react",
    "preview": "npm run preview -w hybrid-react",
    "test": "npm run test -w hybrid-react",
    "test:engine": "npm run test:engine -w @performance-os/engine",
    "lint": "eslint apps/mobile/src packages/engine/src apps/mobile/tests packages/engine/tests"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0"
  }
}
